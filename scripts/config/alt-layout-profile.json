{
  "profile": "genui@0.7.0-alpha.7",
  "canvas": {
    "2x2": {
      "width": 140,
      "height": 140,
      "padding": 12,
      "radius": 18
    },
    "2x4": {
      "width": 300,
      "height": 140,
      "padding": 12,
      "radius": 22
    }
  },
  "limits": {
    "2x2": {
      "maxDepth": 4,
      "maxNodes": 10,
      "maxText": 4,
      "maxButtons": 1,
      "maxImages": 2,
      "maxProgress": 1,
      "maxCheckbox": 0,
      "maxLists": 0,
      "maxVisibleTextUnits": 32
    },
    "2x4": {
      "maxDepth": 5,
      "maxNodes": 18,
      "maxText": 8,
      "maxButtons": 2,
      "maxImages": 3,
      "maxProgress": 2,
      "maxCheckbox": 3,
      "maxLists": 1,
      "maxVisibleTextUnits": 72,
      "maxVisibleListItems": 3
    }
  },
  "spacing": {
    "rootGap": 8,
    "nestedGap": 6,
    "denseGap": 4,
    "allowed": [2, 4, 6, 8, 10, 12, 14, 16]
  },
  "textRules": {
    "maxLines": {
      "title": 2,
      "primary": 1,
      "status": 1,
      "warning": 1,
      "error": 1,
      "metric": 1,
      "support": 2,
      "meta": 2,
      "action": 1,
      "default": 1
    },
    "protectedSingleLineRoles": [
      "primary",
      "status",
      "warning",
      "error",
      "metric",
      "action"
    ],
    "fontAdaptation": {
      "title": {"minSize": 12, "step": 2},
      "primary": {"minSize": 16, "step": 2},
      "status": {"minSize": 12, "step": 2},
      "warning": {"minSize": 12, "step": 2},
      "error": {"minSize": 12, "step": 2},
      "metric": {"minSize": 14, "step": 2},
      "support": {"minSize": 10, "step": 1},
      "meta": {"minSize": 8, "step": 1},
      "action": {"minSize": 12, "step": 2}
    }
  },
  "typography": {
    "regular": {
      "title": [14, 600],
      "primary": [32, 500],
      "status": [14, 500],
      "warning": [14, 500],
      "error": [14, 500],
      "metric": [20, 500],
      "support": [12, 400],
      "meta": [10, 400],
      "action": [14, 500],
      "default": [14, 400]
    },
    "compact": {
      "title": [14, 600],
      "primary": [20, 500],
      "status": [14, 500],
      "warning": [14, 500],
      "error": [14, 500],
      "metric": [18, 500],
      "support": [12, 400],
      "meta": [10, 400],
      "action": [14, 500],
      "default": [12, 400]
    }
  }
}
