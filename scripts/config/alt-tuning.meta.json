      "min": 1.0,
      "max": 2.0,
      "step": 0.01,
      "unit": "倍",
      "tooltip": "按钮 label 的宽度安全系数，比普通文本略紧，因为按钮文案通常更短。"
    },
    {
      "path": "text.lineHeightPadding",
      "name": "行高纵向余量",
      "category": "text",
      "group": "文本测量",
      "type": "number",
      "min": 0,
      "max": 16,
      "step": 1,
      "unit": "vp",
      "tooltip": "行高 = 字号 + 该值，用于文本的垂直高度预算。"
    },
    {
      "path": "text.minimumWidthChars",
