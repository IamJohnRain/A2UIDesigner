    {
      "path": "text.widthSafety",
      "name": "文本宽度安全系数",
      "category": "text",
      "group": "文本测量",
      "type": "number",
      "min": 1.0,
      "max": 2.0,
      "step": 0.01,
      "unit": "倍",
      "tooltip": "文本预估宽度 = 字符单位 × 字号 × 字重系数 × 安全系数。大于 1 时为渲染留出余量，防止文字被截断。"
    },
    {
      "path": "text.buttonWidthSafety",
      "name": "按钮文案宽度安全系数",
      "category": "text",
      "group": "文本测量",
