{
    "version": "v0.9",
    "createSurface": {
        "surfaceId": "surface_card",
        "catalogId": "ohos.a2ui.extended.catalog",
        "width": 300,
        "height": 140
    }
}
{
    "version": "v0.9",
    "updateComponents": {
        "surfaceId": "surface_card",
        "root": "root",
        "components": [
            {
                "id": "root",
                "component": "Row",
                "children": [
                    "main_row"
                ],
                "styles": {
                    "width": 300,
                    "height": 140,
                    "padding": 12,
                    "borderRadius": 22,
                    "linearGradient": {
                        "direction": "RightBottom",
                        "colors": [
                            [
                                "#ff191a1c",
                                0
                            ],
                            [
                                "#5550a6",
                                0.58
                            ],
                            [
                                "#634794",
                                1
                            ]
                        ]
                    },
                    "clip": true
                }
            },
            {
                "id": "main_row",
                "component": "Row",
                "itemMargin": 12,
                "children": [
                    "left_panel",
                    "right_panel"
                ],
                "styles": {
                    "width": 276,
                    "height": 116,
                    "alignItems": "center"
                }
            },
            {
                "id": "left_panel",
                "component": "Column",
                "itemMargin": 6,
                "children": [
                    "hero_label_row",
                    "battery_row",
                    "status_pill"
                ],
                "styles": {
                    "width": 132,
                    "height": 116,
                    "padding": 8,
                    "justifyContent": "center",
                    "alignItems": "start",
                    "borderRadius": 18,
                    "backgroundColor": "#19ffffff"
                }
            },
            {
                "id": "hero_label_row",
                "component": "Row",
                "itemMargin": 6,
                "children": [
                    "battery_icon_small",
                    "hero_label"
                ],
                "styles": {
                    "width": 116,
                    "height": 18,
                    "alignItems": "center"
                }
            },
            {
                "id": "battery_icon_small",
                "component": "Image",
                "styles": {
                    "width": 18,
                    "height": 18,
                    "objectFit": "contain",
                    "borderRadius": 6,
                    "backgroundColor": "#ffffffff"
                },
                "src": "{{ ${/assets/batteryIcon} }}"
            },
            {
                "id": "hero_label",
                "component": "Text",
                "styles": {
                    "width": 92,
                    "height": 18,
                    "fontSize": 14,
                    "fontWeight": 500,
                    "maxLines": 1,
                    "fontColor": "#ffffffff"
                },
                "content": "当前电量"
            },
            {
                "id": "battery_row",
                "component": "Row",
                "itemMargin": 6,
                "children": [
                    "battery_icon_large",
                    "battery_value_col"
                ],
                "styles": {
                    "width": 116,
                    "height": 58,
                    "alignItems": "center"
                }
            },
            {
                "id": "battery_icon_large",
                "component": "Image",
                "styles": {
                    "width": 54,
                    "height": 54,
                    "objectFit": "contain",
                    "borderRadius": 16,
                    "backgroundColor": "#ffffffff"
                },
                "src": "{{ ${/assets/batteryIcon} }}"
            },
            {
                "id": "battery_value_col",
                "component": "Column",
                "itemMargin": 4,
                "children": [
                    "primary_value",
                    "primary_caption"
                ],
                "styles": {
                    "width": 56,
                    "height": 58,
                    "justifyContent": "center",
                    "alignItems": "start"
                }
            },
            {
                "id": "primary_value",
                "component": "Text",
                "styles": {
                    "width": 56,
                    "height": 36,
                    "fontSize": 32,
                    "fontWeight": 700,
                    "maxLines": 1,
                    "fontColor": "#ffffffff"
                },
                "content": "{{ ${/battery/levelText} }}"
            },
            {
                "id": "primary_caption",
                "component": "Text",
                "styles": {
                    "width": 56,
                    "height": 18,
                    "fontSize": 12,
                    "fontWeight": 500,
                    "maxLines": 1,
                    "fontColor": "#ffdb6b42"
                },
                "content": "{{ ${/battery/statusText} }}"
            },
            {
                "id": "status_pill",
                "component": "Progress",
                "styles": {
                    "width": 116,
                    "height": 8,
                    "type": "capsule",
                    "color": "#ffdb6b42",
                    "backgroundColor": "#33ffffff"
                },
                "value": "{{ ${/battery/levelValue} }}",
                "total": "{{ ${/battery/levelTotal} }}"
            },
            {
                "id": "right_panel",
                "component": "Column",
                "itemMargin": 4,
                "children": [
                    "switch_dark",
                    "switch_refresh",
                    "switch_background",
                    "alert_banner"
                ],
                "styles": {
                    "width": 132,
                    "height": 116,
                    "padding": [
                        2,
                        0,
                        2,
                        0
                    ],
                    "justifyContent": "center",
                    "alignItems": "start",
                    "borderRadius": 18,
                    "backgroundColor": "#19ffffff"
                }
            },
            {
                "id": "switch_dark",
                "component": "Checkbox",
                "styles": {
                    "width": 132,
                    "height": 24,
                    "shape": "rounded_square",
                    "selectedColor": "#ff5ba854",
                    "unSelectedColor": "#33ffffff"
                },
                "onClick": [
                    {
                        "call": "clickToIntent",
                        "args": {
                            "intentName": "SetSettingSwitch",
                            "params": {
                                "appBundleName": "com.huawei.hmos.settings",
                                "itemName": "battery_saving_mode",
                                "switchFlag": 0
                            }
                        }
                    }
                ],
                "select": "{{ ${/switches/darkModeOn} }}",
                "value": "dark_mode",
                "label": "深色模式",
                "group": "power_options"
            },
            {
                "id": "switch_refresh",
                "component": "Checkbox",
                "styles": {
                    "width": 132,
                    "height": 24,
                    "shape": "rounded_square",
                    "selectedColor": "#ff5ba854",
                    "unSelectedColor": "#33ffffff"
                },
                "onClick": [
                    {
                        "call": "clickToIntent",
                        "args": {
                            "intentName": "SetSettingSwitch",
                            "params": {
                                "appBundleName": "com.huawei.hmos.settings",
                                "itemName": "battery_saving_mode",
                                "switchFlag": 0
                            }
                        }
                    }
                ],
                "select": "{{ ${/switches/refreshRateReduced} }}",
                "value": "refresh_rate",
                "label": "降低刷新率",
                "group": "power_options"
            },
            {
                "id": "switch_background",
                "component": "Checkbox",
                "styles": {
                    "width": 132,
                    "height": 24,
                    "shape": "rounded_square",
                    "selectedColor": "#ff5ba854",
                    "unSelectedColor": "#33ffffff"
                },
                "onClick": [
                    {
                        "call": "clickToIntent",
                        "args": {
                            "intentName": "SetSettingSwitch",
                            "params": {
                                "appBundleName": "com.huawei.hmos.settings",
                                "itemName": "battery_saving_mode",
                                "switchFlag": 0
                            }
                        }
                    }
                ],
                "select": "{{ ${/switches/backgroundClosed} }}",
                "value": "background_close",
                "label": "关后台",
                "group": "power_options"
            },
            {
                "id": "alert_banner",
                "component": "Text",
                "styles": {
                    "width": 132,
                    "height": 28,
                    "padding": [
                        4,
                        8,
                        4,
                        8
                    ],
                    "fontSize": 12,
                    "fontWeight": 500,
                    "maxLines": 2,
                    "borderRadius": 14,
                    "backgroundColor": "#ffdb6b42",
                    "fontColor": "#ffffffff"
                },
                "content": "{{ ${/battery/reminder} }}"
            }
        ]
    }
}
{
    "version": "v0.9",
    "updateDataModel": {
        "surfaceId": "surface_card",
        "path": "/",
        "value": {
            "battery": {
                "levelText": "15%",
                "levelValue": 15,
                "levelTotal": 100,
                "statusText": "红色告警",
                "reminder": "当前处于夜间时段,耗电较快"
            },
            "switches": {
                "darkModeOn": true,
                "refreshRateReduced": true,
                "backgroundClosed": true
            },
            "assets": {
                "batteryIcon": "resources/base/media/icon_electricity.png"
            }
        }
    }
}