{
  "type": "object",
  "$defs": {
    "NonNegativeNumberValue": {
      "oneOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "$ref": "../common_types.json#/$defs/ExtendedDynamicValueRef"
        }
      ]
    },
    "ResponsiveTemplateValue": {
      "type": "object",
      "properties": {
        "xs": { "$ref": "../common_types.json#/$defs/ExtendedDynamicString" },
        "sm": { "$ref": "../common_types.json#/$defs/ExtendedDynamicString" },
        "md": { "$ref": "../common_types.json#/$defs/ExtendedDynamicString" },
        "lg": { "$ref": "../common_types.json#/$defs/ExtendedDynamicString" },
        "xl": { "$ref": "../common_types.json#/$defs/ExtendedDynamicString" }
      },
      "additionalProperties": false
    },
    "GridTemplateValue": {
      "oneOf": [
        {
          "$ref": "../common_types.json#/$defs/ExtendedDynamicString"
        },
        {
          "$ref": "#/$defs/ResponsiveTemplateValue"
        }
      ]
    }
  },
  "allOf": [
    {
      "$ref": "../common_types.json#/$defs/ComponentCommon"
    },
    {
      "$ref": "../common_types.json#/$defs/CatalogComponentCommon"
    },
    {
      "type": "object",
      "properties": {
        "component": {
          "const": "Grid"
        },
        "children": {
          "$ref": "../common_types.json#/$defs/ChildList",
          "description": "Child component IDs or a template child list."
        },
        "styles": {
          "type": "object",
          "properties": {
            "columnsTemplate": {
              "$ref": "#/$defs/GridTemplateValue",
              "description": "Grid column template such as 1fr 1fr 2fr."
            },
            "rowsTemplate": {
              "$ref": "#/$defs/GridTemplateValue",
              "description": "Grid row template such as 1fr 1fr 2fr."
            },
            "columnsGap": {
              "$ref": "#/$defs/NonNegativeNumberValue",
              "description": "Gap between columns."
            },
            "rowsGap": {
              "$ref": "#/$defs/NonNegativeNumberValue",
              "description": "Gap between rows."
            }
          },
          "additionalProperties": true
        }
      },
      "required": [
        "component"
      ]
    }
  ],
  "additionalProperties": true
}
