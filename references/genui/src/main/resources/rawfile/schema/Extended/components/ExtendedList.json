{
  "type": "object",
  "$defs": {
    "NonNegativeNumberValue": {
      "oneOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)(?:\\.\\d+)?$"
        },
        {
          "$ref": "../common_types.json#/$defs/ExtendedDynamicValueRef"
        }
      ]
    },
    "ListDirectionLiteral": {
      "type": "string",
      "enum": [
        "vertical",
        "horizontal"
      ]
    },
    "ScrollBarLiteral": {
      "type": "string",
      "enum": [
        "off",
        "auto",
        "on"
      ]
    },
    "NestedScrollMode": {
      "type": "string",
      "enum": [
        "selfOnly",
        "selfFirst",
        "parentFirst",
        "paraller"
      ]
    },
    "DynamicNestedScrollMode": {
      "oneOf": [
        {
          "$ref": "#/$defs/NestedScrollMode"
        },
        {
          "$ref": "../common_types.json#/$defs/ExtendedDynamicValueRef"
        }
      ]
    },
    "NestedScrollOptions": {
      "type": "object",
      "properties": {
        "scrollForward": {
          "$ref": "#/$defs/DynamicNestedScrollMode"
        },
        "scrollBackward": {
          "$ref": "#/$defs/DynamicNestedScrollMode"
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "$ref": "../common_types.json#/$defs/ComponentCommon"
    },
    {
      "$ref": "../common_types.json#/$defs/CatalogComponentCommon"
    },
    {
      "type": "object",
      "properties": {
        "component": {
          "const": "List"
        },
        "children": {
          "$ref": "../common_types.json#/$defs/ChildList",
          "description": "Child component IDs or a template child list."
        },
        "space": {
          "$ref": "#/$defs/NonNegativeNumberValue",
          "description": "Main-axis spacing between list items."
        },
        "styles": {
          "type": "object",
          "properties": {
            "listDirection": {
              "description": "List layout direction.",
              "oneOf": [
                {
                  "$ref": "#/$defs/ListDirectionLiteral"
                },
                {
                  "$ref": "../common_types.json#/$defs/ExtendedDynamicValueRef"
                }
              ]
            },
            "scrollBar": {
              "description": "Scroll bar display mode.",
              "oneOf": [
                {
                  "$ref": "#/$defs/ScrollBarLiteral"
                },
                {
                  "$ref": "../common_types.json#/$defs/ExtendedDynamicValueRef"
                }
              ]
            },
            "nestedScroll": {
              "description": "Nested scroll mode configuration.",
              "oneOf": [
                {
                  "$ref": "#/$defs/NestedScrollOptions"
                },
                {
                  "$ref": "#/$defs/NestedScrollMode"
                },
                {
                  "$ref": "../common_types.json#/$defs/ExtendedDynamicValueRef"
                }
              ]
            }
          },
          "additionalProperties": true
        }
      },
      "required": [
        "component"
      ]
    }
  ],
  "additionalProperties": true
}
