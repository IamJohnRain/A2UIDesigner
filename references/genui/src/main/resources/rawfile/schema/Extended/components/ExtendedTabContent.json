{
  "type": "object",
  "$defs": {
    "DynamicTabType": {
      "oneOf": [
        {
          "type": "string",
          "enum": ["", "capsule", "underline"]
        },
        {
          "$ref": "../common_types.json#/$defs/ExtendedDynamicValueRef"
        }
      ]
    },
    "NonNegativeNumberValue": {
      "oneOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "$ref": "../common_types.json#/$defs/ExtendedDynamicValueRef"
        }
      ]
    },
    "FontWeight": {
      "oneOf": [
        {
          "type": "integer",
          "enum": [100, 200, 300, 400, 500, 600, 700, 800, 900]
        },
        {
          "type": "string",
          "enum": ["lighter", "normal", "regular", "medium", "bold", "bolder"]
        },
        {
          "$ref": "../common_types.json#/$defs/ExtendedDynamicValueRef"
        }
      ]
    },
    "BindingPathMap": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        },
        "selectedSrc": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "$ref": "../common_types.json#/$defs/ComponentCommon"
    },
    {
      "$ref": "../common_types.json#/$defs/CatalogComponentCommon"
    },
    {
      "type": "object",
      "properties": {
        "component": {
          "const": "TabContent"
        },
        "title": {
          "$ref": "../common_types.json#/$defs/ExtendedDynamicString"
        },
        "icon": {
          "$ref": "../common_types.json#/$defs/ExtendedDynamicString"
        },
        "selectedSrc": {
          "$ref": "../common_types.json#/$defs/ExtendedDynamicString"
        },
        "tabType": {
          "$ref": "#/$defs/DynamicTabType"
        },
        "__a2uiBindings": {
          "$ref": "#/$defs/BindingPathMap",
          "description": "Optional binding path map consumed by Extended.TabContent for string-backed property fields."
        },
        "styles": {
          "allOf": [
            {
              "$ref": "../common_types.json#/$defs/ExtendedCommonStyles"
            },
            {
              "type": "object",
              "properties": {
                "selectedColor": {
                  "$ref": "../common_types.json#/$defs/ExtendedDynamicString",
                  "description": "Text color of the selected tabBar title."
                },
                "unSelectedColor": {
                  "$ref": "../common_types.json#/$defs/ExtendedDynamicString",
                  "description": "Text color of the unselected tabBar title."
                },
                "defaultBackgroundColor": {
                  "$ref": "../common_types.json#/$defs/ExtendedDynamicString",
                  "description": "Background color of the unselected tabBar title."
                },
                "selectedBackgroundColor": {
                  "$ref": "../common_types.json#/$defs/ExtendedDynamicString",
                  "description": "Background color of the selected tabBar title."
                },
                "defaultBorderColor": {
                  "$ref": "../common_types.json#/$defs/ExtendedDynamicString",
                  "description": "Border color of the unselected tabBar title."
                },
                "selectedBorderColor": {
                  "$ref": "../common_types.json#/$defs/ExtendedDynamicString",
                  "description": "Border color of the selected tabBar title."
                },
                "fontSize": {
                  "$ref": "#/$defs/NonNegativeNumberValue"
                },
                "fontWeight": {
                  "$ref": "#/$defs/FontWeight"
                },
                "iconSize": {
                  "$ref": "#/$defs/NonNegativeNumberValue"
                },
                "space": {
                  "$ref": "#/$defs/NonNegativeNumberValue"
                }
              },
              "additionalProperties": true
            }
          ]
        },
        "children": {
          "$ref": "../common_types.json#/$defs/ChildList",
          "description": "Child component IDs or template source rendered inside the tab content area."
        }
      },
      "required": [
        "component"
      ]
    }
  ],
  "additionalProperties": true
}
