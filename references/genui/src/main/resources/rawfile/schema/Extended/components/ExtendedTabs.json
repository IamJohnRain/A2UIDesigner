{
  "type": "object",
  "$defs": {
    "DynamicBarPosition": {
      "oneOf": [
        {
          "type": "string",
          "enum": ["start", "end"]
        },
        {
          "$ref": "../common_types.json#/$defs/ExtendedDynamicValueRef"
        }
      ]
    },
    "NonNegativeIntegerValue": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "$ref": "../common_types.json#/$defs/ExtendedDynamicValueRef"
        }
      ]
    },
    "OnChangeHandler": {
      "oneOf": [
        {
          "$ref": "../common_types.json#/$defs/FunctionCall"
        },
        {
          "type": "object",
          "properties": {
            "functionCall": {
              "$ref": "../common_types.json#/$defs/FunctionCall"
            }
          },
          "required": ["functionCall"],
          "additionalProperties": true
        }
      ]
    }
  },
  "allOf": [
    {
      "$ref": "../common_types.json#/$defs/ComponentCommon"
    },
    {
      "$ref": "../common_types.json#/$defs/CatalogComponentCommon"
    },
    {
      "type": "object",
      "properties": {
        "component": {
          "const": "Tabs"
        },
        "barPosition": {
          "$ref": "#/$defs/DynamicBarPosition",
          "description": "Tab bar position. 'start': left when vertical=true, top when vertical=false. 'end': right when vertical=true, bottom when vertical=false."
        },
        "children": {
          "$ref": "../common_types.json#/$defs/ChildList",
          "description": "Tab content component IDs or template source. Child component type must be TabContent."
        },
        "vertical": {
          "$ref": "../common_types.json#/$defs/ExtendedDynamicBoolean",
          "description": "Whether the tabs render vertically. Supports expressions and dynamic boolean values."
        },
        "scrollable": {
          "$ref": "../common_types.json#/$defs/ExtendedDynamicBoolean",
          "description": "Whether the tab bar can scroll. Supports expressions and dynamic boolean values."
        },
        "tabIndex": {
          "$ref": "#/$defs/NonNegativeIntegerValue",
          "description": "Initial selected tab index. The resolved value must be smaller than the resolved TabContent count."
        },
        "onChange": {
          "$ref": "#/$defs/OnChangeHandler",
          "description": "Callback invoked after tab switch completes. Supports either a direct FunctionCall or { functionCall: FunctionCall }."
        },
        "styles": {
          "description": "Shared container style overrides consumed by ExtendedCommonStyleModifier.",
          "allOf": [
            {
              "$ref": "../common_types.json#/$defs/ExtendedCommonStyles"
            }
          ]
        }
      },
      "required": [
        "component"
      ]
    }
  ],
  "additionalProperties": true
}
